# Local development only. Never commit a real key or share it.
VOICE_CREATE_KEY=replace-with-a-random-secret-of-at-least-32-chars
HOST=127.0.0.1
PORT=8787
# Must match the HTTPS origin behind your reverse proxy
PUBLIC_ORIGIN=http://localhost:8787
ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]
# Optional coturn REST auth; never put static TURN passwords in ICE_SERVERS_JSON
# TURN_SHARED_SECRET=
# TURN_URIS=turn:your-turn-host:3478
